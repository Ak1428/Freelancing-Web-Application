# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/freelance_app?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# For Vercel production, set NEXTAUTH_URL automatically or use the preview deployment URL.
# Optional compatibility alias used by some deployments:
AUTH_SECRET="replace-with-a-strong-random-secret"

# Pusher Real-time Configuration (Optional)
NEXT_PUBLIC_PUSHER_APP_KEY="your-pusher-app-key"
NEXT_PUBLIC_PUSHER_CLUSTER="your-pusher-cluster"
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_APP_SECRET="your-pusher-app-secret"

# Node Environment
NODE_ENV="production"
